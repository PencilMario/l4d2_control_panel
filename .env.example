L4D2_PANEL_ADMIN_PASSWORD=replace-with-a-long-random-password
# deploy.sh generates this automatically when it is missing.
L4D2_PANEL_CRASH_REPORT_TOKEN=
L4D2_PANEL_STACKWALK_PATH=/usr/local/bin/minidump_stackwalk
L4D2_PANEL_DUMP_SYMS_PATH=/usr/local/bin/dump_syms
L4D2_PANEL_DATA_ROOT=/srv/l4d2-panel
L4D2_PANEL_HTTP_PORT=18081
L4D2_PANEL_GAME_HOST=host.docker.internal
L4D2_PANEL_DOCKER_PROXY_PORT=23750
L4D2_PANEL_DOWNLOAD_PROXY=
ALPINE_IMAGE=alpine:3.22
STEAMCMD_IMAGE=cm2network/steamcmd:root
NODE_IMAGE=node:22-alpine
GO_IMAGE=golang:1.25-alpine
